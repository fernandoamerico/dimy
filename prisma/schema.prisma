generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SchemaCollection {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  icon      String?
  metadata  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  documents Document[]
  fields    SchemaField[]
}

model SchemaField {
  id           String           @id @default(cuid())
  name         String
  label        String
  type         String
  required     Boolean          @default(false)
  collectionId String
  order        Int              @default(0)
  relationTo   String?
  collection   SchemaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model Document {
  id           String           @id @default(cuid())
  collectionId String
  data         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  collection   SchemaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  role      String   @default("read")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Extension {
  id          String   @id
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
