// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// SCHEMA BUILDER (Meta-schema para as Coleções)
// ------------------------------------------------------

// Representa uma Coleção criada pelo usuário (ex: "Posts", "Produtos")
model SchemaCollection {
  id        String   @id @default(cuid())
  name      String   // "Artigos"
  slug      String   @unique // "artigos" (usado na API: /api/dimy/artigos)
  icon      String?  // Ícone Lucide opcional
  
  fields    SchemaField[]
  documents Document[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Representa um Campo dentro de uma Coleção (ex: "Título", "Conteúdo")
model SchemaField {
  id           String           @id @default(cuid())
  name         String           // "title" (chave do JSON)
  label        String           // "Título da Postagem" (Nome exibido)
  type         String           // "text", "richText", "image", "number", "boolean", "relation"
  required     Boolean          @default(false)
  
  collectionId String
  collection   SchemaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  order        Int              @default(0) // Para ordenar na UI
  relationTo   String?          // Slug da coleção relacionada (usado apenas se type === 'relation')
}

// ------------------------------------------------------
// DATA STORE (Armazenamento flexível dos conteúdos)
// ------------------------------------------------------

// Armazena os registros (linhas) de qualquer Coleção no formato JSON
model Document {
  id           String           @id @default(cuid())
  
  collectionId String
  collection   SchemaCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  data         String           // O payload JSON com os dados do registro
  
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ------------------------------------------------------
// SYSTEM & AUTHENTICATION
// ------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  key       String   @id // e.g. "projectName"
  value     String
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String   // Nome para identificar a chave (ex: "Front-end Principal")
  key       String   @unique // O token gerado (hasheado ou texto plano dependendo do nível de segurança, vamos manter texto plano para facilitar o uso no MVP)
  role      String   @default("read") // "read" ou "write"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// EXTENSIONS (Marketplace & Core Modules)
// ------------------------------------------------------

model Extension {
  id        String   @id // ex: 'core_dashboard', 'schema_publications'
  enabled   Boolean  @default(true)
  installedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
